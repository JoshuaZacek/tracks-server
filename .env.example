# Copy to .env and fill in. .env is gitignored and only read by the server.

# --- Server -------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
# Express "trust proxy": number of proxies in front of the API (1 behind Caddy), or false.
TRUST_PROXY=false

# --- Database -----------------------------------------------------------------
DATABASE_URL=postgres://localhost:5432/tracks
# Used by `npm test` (the database is dropped and recreated on every run).
TEST_DATABASE_URL=postgres://localhost:5432/tracks_test

# --- Reference data -------------------------------------------------------------
# Where the schedule extract and other downloads live (gitignored).
DATA_DIR=./data
# Local UK time for the worker's daily refresh (schedule re-import, stations).
SCHEDULE_REFRESH_TIME=04:00

# --- Rail Data Marketplace ----------------------------------------------------------
# Header RDM expects the consumer key in. Change only if a product page says otherwise.
RDM_AUTH_HEADER=x-apikey
# Knowledgebase Stations: per-station URL with a {crs} placeholder, as on the product page.
KB_STATIONS_URL=
KB_STATIONS_API_KEY=
# NWR Schedule is a file product. Leave blank and put CIF_ALL_FULL_DAILY_toc-full.json.gz in
# DATA_DIR by hand; the worker re-imports whenever that file is newer than the last import.
NWR_SCHEDULE_URL=
NWR_SCHEDULE_API_KEY=
NWR_SCHEDULE_USERNAME=
NWR_SCHEDULE_PASSWORD=

# --- Darwin Push Port (Rail Data Marketplace) ------------------------------------
# From the Darwin Push Port product page on RDM, "Pub/Sub" / "Kafka" section.
# Bootstrap server, e.g. pkc-xxxxx.europe-west2.gcp.confluent.cloud:9092
DARWIN_KAFKA_BOOTSTRAP=
# Topic name, exactly as shown on the product page
DARWIN_KAFKA_TOPIC=
# Consumer group ID (RDM gives you one, or a required prefix for it)
DARWIN_KAFKA_GROUP_ID=
# The Kafka username and password (often labelled "API key" and "API secret")
DARWIN_KAFKA_USERNAME=
DARWIN_KAFKA_PASSWORD=
# SASL mechanism the product page lists: plain, scram-sha-256 or scram-sha-512
DARWIN_KAFKA_SASL_MECHANISM=plain
# Optional: if your subscription also includes Darwin's timetable/reference files
# (reason codes, operator names), their URL and key. Leave blank if not shown.
DARWIN_REFERENCE_URL=
DARWIN_REFERENCE_API_KEY=

# --- Later phases (not read yet) ------------------------------------------------
# TRUST (optional, Phase 6): TRUST_KAFKA_*
# APNs (Phase 5): APNS_KEY_ID, APNS_TEAM_ID, APNS_KEY_PATH, APNS_BUNDLE_ID,
#   APNS_DEFAULT_ENV=sandbox

# ---- APNs (push notifications and Live Activities) ----
# Token-based auth with a .p8 key from Apple Developer > Certificates, Identifiers & Profiles > Keys
# (enable "Apple Push Notifications service"). Keep the .p8 outside the repo.
# With any of these blank the worker still works out every alert and Live Activity update, but only
# records them in push_log (outcome "disabled") instead of sending them.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PATH=
APNS_BUNDLE_ID=

# ---- Production (docker-compose.yml) ----
# The public name Caddy serves HTTPS for (DNS must point here); `localhost` to try the stack locally.
DOMAIN=
# Required by docker-compose.yml: generate with `openssl rand -hex 24`.
POSTGRES_PASSWORD=
# Days of daily backups kept in ./backups.
BACKUP_KEEP_DAYS=14
